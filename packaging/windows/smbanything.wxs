<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Windows package: an MSI installing smbanything under %ProgramFiles%\smbanything with bin
  on the machine PATH, and nothing else — no service, no shortcut, no config, like the .deb,
  .rpm and .pkg. The one addition is the Wintun driver DLL beside the exe, which the packet tunnel
  loads from there after checking its pinned SHA-256 (smbanything_core/src/smb/tun.rs), and
  Wintun's licence, which its redistribution terms require to travel with it.

  Built by packaging/build-windows-msi.ps1 with WiX 5 (`wix build`), which defines
    Version: Cargo's version with any pre-release suffix removed (an MSI version is x.y.z)
    Stage:   the assembled release tree (bin\, share\, VERSION)
  The UpgradeCode is what makes a newer MSI replace an installed older one instead of sitting
  beside it; it must never change. Component GUIDs derive from the install paths, which do not
  change either.

  The UI is WiX's stock InstallDir wizard (WixToolset.UI.wixext): welcome, folder, confirm,
  progress, and the finish page that says the install succeeded. Its licence page is skipped,
  below, because this project ships no licence text to put on it. `msiexec /qn` never shows
  any of it, so the unattended install and the CI smoke test are unchanged.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="smbanything" Manufacturer="andrewtheguy" Version="$(var.Version)"
           UpgradeCode="332ca06c-c5fa-4609-b9fa-8c1cdd9acdf3" Scope="perMachine">
    <SummaryInformation Description="Browse ZIP and TAR archives through a read-only SMB share" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of smbanything is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andrewtheguy/smbanything" />

    <!-- The dialog set also sets ARPNOMODIFY: no Change button in Apps & features. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <!-- Straight from the welcome page to the folder page: no licence dialog. Order 99 puts
           these after the dialog set's own transitions, so they are the ones that take. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
    </UI>
    <!-- The PATH change reaches only shells opened after the install. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="smbanything is on the PATH of every shell opened from now on. Run smbanything from a terminal; --smb-tun needs an elevated one." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="smbanything">
        <Directory Id="BinDir" Name="bin" />
        <Directory Id="ShareDir" Name="share">
          <Directory Id="ShareDocDir" Name="doc">
            <Directory Id="DocDir" Name="smbanything" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Program">
      <Component Directory="BinDir">
        <File Source="$(var.Stage)\bin\smbanything.exe" />
        <!-- On every account's PATH, as /usr/bin/smbanything is; removed with the package. -->
        <Environment Id="PathEntry" Name="PATH" Value="[BinDir]" Part="last" Action="set" System="yes" />
      </Component>
      <Component Directory="BinDir">
        <File Source="$(var.Stage)\bin\wintun-amd64.dll" />
      </Component>
      <Component Directory="DocDir">
        <File Source="$(var.Stage)\share\doc\smbanything\WINTUN-LICENSE.txt" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="$(var.Stage)\VERSION" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="Program" />
    </Feature>
  </Package>
</Wix>
